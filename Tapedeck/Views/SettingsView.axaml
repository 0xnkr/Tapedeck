<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Tapedeck.Resources"
             xmlns:vm="using:Tapedeck.ViewModels"
             xmlns:controls="using:Tapedeck.Controls"
             xmlns:converters="using:Tapedeck.Converters"
             x:Class="Tapedeck.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- One project in the credits: the license pill opens its text, the arrow its website -->
        <DataTemplate x:Key="CreditCard" x:DataType="vm:CreditViewModel">
            <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space.2}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="support" Text="{Binding Purpose}" Foreground="{DynamicResource Brush.Text2}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="link"
                            VerticalAlignment="Center"
                            Command="{Binding ShowLicenseCommand}"
                            ToolTip.Tip="{Binding LicenseLabel}"
                            AutomationProperties.Name="{Binding LicenseLabel}">
                        <Border Classes="pill">
                            <TextBlock Classes="caption" Text="{Binding License}" />
                        </Border>
                    </Button>
                    <Button Grid.Column="2"
                            Classes="icon"
                            VerticalAlignment="Center"
                            Command="{Binding OpenCommand}"
                            ToolTip.Tip="{Binding OpenLabel}"
                            AutomationProperties.Name="{Binding OpenLabel}">
                        <controls:Glyph Data="{StaticResource Icon.ExternalLink}" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Island heading with a hint below -->
        <Style Selector="StackPanel.heading">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <!-- Small label above a field -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>
        <!-- The open source cards: three side by side, fewer as the page narrows (set here, not on the grid, so the
             container queries below can change it) -->
        <Style Selector="UniformGrid.credits">
            <Setter Property="Columns" Value="3" />
        </Style>
        <ContainerQuery Name="page" Query="max-width:1000">
            <Style Selector="UniformGrid.credits">
                <Setter Property="Columns" Value="2" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="page" Query="max-width:720">
            <Style Selector="UniformGrid.credits">
                <Setter Property="Columns" Value="1" />
            </Style>
        </ContainerQuery>
        <!-- Setting title with its hint on the left, control on the right -->
        <Style Selector="TextBlock.setting-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource Space.3}"
          Container.Name="page" Container.Sizing="Width">

        <controls:PageHeader Title="{x:Static res:Strings.Settings_Title}" />

        <TextBlock Grid.Row="1"
                   Classes="support"
                   Text="{Binding Notice}"
                   Foreground="{DynamicResource Brush.Error}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{StaticResource Space.3}">
                <controls:AdaptiveColumns Spacing="{StaticResource Space.3}">

                    <!-- Left: library and appearance -->
                    <StackPanel Spacing="{StaticResource Space.3}">
                        <controls:Island Classes="large">
                            <StackPanel Spacing="{StaticResource Space.4}">
                                <StackPanel Classes="heading">
                                    <TextBlock Classes="title" Text="{x:Static res:Strings.Settings_Library}" />
                                    <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap"
                                               Text="{Binding LibraryHint}" />
                                </StackPanel>

                                <StackPanel Spacing="{StaticResource Space.2}">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.Settings_Location}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.2}">
                                        <TextBox Text="{Binding LibraryDir}"
                                                 IsReadOnly="True"
                                                 MinHeight="{StaticResource Control.Xl}"
                                                 AutomationProperties.Name="{x:Static res:Strings.Settings_Location}" />
                                        <Button Grid.Column="1"
                                                Classes="tonal xl"
                                                Content="{x:Static res:Strings.Settings_Change}"
                                                Command="{Binding ChangeLibraryCommand}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Several downloads at once finish a long list sooner -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="{x:Static res:Strings.Settings_ParallelDownloads}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_ParallelDownloadsHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="ParallelDownloads" Content="1"
                                                         AutomationProperties.Name="{x:Static res:Strings.Settings_ParallelDownloads}">
                                                <RadioButton.IsChecked>
                                                    <Binding Path="ParallelDownloads" Converter="{x:Static converters:EqualsConverter.INSTANCE}">
                                                        <Binding.ConverterParameter>
                                                            <x:Int32>1</x:Int32>
                                                        </Binding.ConverterParameter>
                                                    </Binding>
                                                </RadioButton.IsChecked>
                                            </RadioButton>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="ParallelDownloads" Content="2"
                                                         AutomationProperties.Name="{x:Static res:Strings.Settings_ParallelDownloads}">
                                                <RadioButton.IsChecked>
                                                    <Binding Path="ParallelDownloads" Converter="{x:Static converters:EqualsConverter.INSTANCE}">
                                                        <Binding.ConverterParameter>
                                                            <x:Int32>2</x:Int32>
                                                        </Binding.ConverterParameter>
                                                    </Binding>
                                                </RadioButton.IsChecked>
                                            </RadioButton>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="ParallelDownloads" Content="3"
                                                         AutomationProperties.Name="{x:Static res:Strings.Settings_ParallelDownloads}">
                                                <RadioButton.IsChecked>
                                                    <Binding Path="ParallelDownloads" Converter="{x:Static converters:EqualsConverter.INSTANCE}">
                                                        <Binding.ConverterParameter>
                                                            <x:Int32>3</x:Int32>
                                                        </Binding.ConverterParameter>
                                                    </Binding>
                                                </RadioButton.IsChecked>
                                            </RadioButton>
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="ParallelDownloads" Content="4"
                                                         AutomationProperties.Name="{x:Static res:Strings.Settings_ParallelDownloads}">
                                                <RadioButton.IsChecked>
                                                    <Binding Path="ParallelDownloads" Converter="{x:Static converters:EqualsConverter.INSTANCE}">
                                                        <Binding.ConverterParameter>
                                                            <x:Int32>4</x:Int32>
                                                        </Binding.ConverterParameter>
                                                    </Binding>
                                                </RadioButton.IsChecked>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="{x:Static res:Strings.Settings_LevelPlayback}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_LevelPlaybackHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static res:Strings.Settings_LevelPlayback}"
                                              IsChecked="{Binding LevelPlayback}" />
                                </Grid>

                                <!-- Some phone players read the tags differently; switching rewrites the files with "Write tags" -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="{x:Static res:Strings.Settings_TargetPlayer}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_TargetPlayerHint}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="tonal"
                                            VerticalAlignment="Center"
                                            Content="{Binding TargetPlayerText}"
                                            AutomationProperties.Name="{x:Static res:Strings.Settings_TargetPlayer}">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight"
                                                        FlyoutPresenterClasses="choice-menu"
                                                        ItemsSource="{Binding TargetPlayerChoices}" />
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="{x:Static res:Strings.Settings_AskBeforeKeep}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_AskBeforeKeepHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static res:Strings.Settings_AskBeforeKeep}"
                                              IsChecked="{Binding AskBeforeKeep}" />
                                </Grid>

                                <StackPanel Spacing="{StaticResource Space.2}">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.Settings_FileName}" />
                                    <Border Classes="code">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="mono" Text="{x:Static res:Strings.Settings_FileNamePattern}" />
                                            <TextBlock Classes="mono" Foreground="{DynamicResource Brush.Text3}"
                                                       Text="{x:Static res:Strings.Settings_FileNameCollision}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </controls:Island>

                        <controls:Island Classes="large">
                            <StackPanel Spacing="{StaticResource Space.4}">
                                <TextBlock Classes="title" Text="{x:Static res:Strings.Settings_Appearance}" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.4}">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body" FontWeight="Medium" Text="{x:Static res:Strings.Settings_Language}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_LanguageHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="Language"
                                                         Content="{x:Static res:Strings.Settings_LanguageSystem}"
                                                         IsChecked="{Binding Language, Converter={x:Static converters:EqualsConverter.INSTANCE}, ConverterParameter={x:Static vm:LanguageChoice.System}}" />
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="Language"
                                                         Content="{x:Static res:Strings.Settings_LanguageEnglish}"
                                                         IsChecked="{Binding Language, Converter={x:Static converters:EqualsConverter.INSTANCE}, ConverterParameter={x:Static vm:LanguageChoice.English}}" />
                                            <RadioButton Theme="{StaticResource Segment}" GroupName="Language"
                                                         Content="{x:Static res:Strings.Settings_LanguageGerman}"
                                                         IsChecked="{Binding Language, Converter={x:Static converters:EqualsConverter.INSTANCE}, ConverterParameter={x:Static vm:LanguageChoice.German}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="{StaticResource Space.2}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="body" FontWeight="Medium" Text="{x:Static res:Strings.Settings_Accent}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_AccentHint}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.2}">
                                        <ItemsControl ItemsSource="{Binding Accents}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AccentOptionViewModel">
                                                    <RadioButton Theme="{StaticResource AccentSwatch}"
                                                                 GroupName="Accent"
                                                                 Background="{Binding Hex, Converter={x:Static converters:HexToBrushConverter.INSTANCE}}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Command="{Binding SelectCommand}"
                                                                 AutomationProperties.Name="{Binding Label}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Classes="chip"
                                                 Width="130"
                                                 Text="{Binding CustomAccent}"
                                                 Classes.user-value="{Binding CustomAccent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 PlaceholderText="#RRGGBB"
                                                 AutomationProperties.Name="{x:Static res:Strings.Settings_AccentCustom}"
                                                 VerticalAlignment="Center">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding ApplyCustomAccentCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </controls:Island>
                    </StackPanel>

                    <!-- Right: tools -->
                    <controls:Island Grid.Column="1" Classes="large" VerticalAlignment="Top">
                        <StackPanel Spacing="{StaticResource Space.3}">
                            <StackPanel Classes="heading">
                                <TextBlock Classes="title" Text="{x:Static res:Strings.Settings_Tools}" />
                                <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.Settings_ToolsHint}" />
                            </StackPanel>

                            <!-- Tapedeck itself: the version to name in a bug report, and the log to attach -->
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="Tapedeck" />
                                        <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                                                   Text="{Binding AppVersion}" />
                                        <!-- a newer release on GitHub; there is no app store to tell -->
                                        <Button Classes="link"
                                                HorizontalAlignment="Left"
                                                Content="{Binding UpdateLabel}"
                                                ToolTip.Tip="{x:Static res:Strings.Settings_UpdateAvailableHint}"
                                                Command="{Binding OpenUpdateCommand}"
                                                IsVisible="{Binding Update, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Content="{x:Static res:Strings.Tools_OpenLog}"
                                            ToolTip.Tip="{x:Static res:Strings.Tools_OpenLogHint}"
                                            controls:ButtonAssist.Icon="{StaticResource Icon.ExternalLink}"
                                            Command="{Binding OpenLogCommand}"
                                            IsVisible="{Binding HasLog}" />
                                </Grid>
                            </Border>

                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="yt-dlp" />
                                        <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                                                   Text="{Binding YtDlpVersion, TargetNullValue={x:Static res:Strings.Tools_NotInstalled}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="primary"
                                            Content="{x:Static res:Strings.Tools_Update}"
                                            controls:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                            Command="{Binding UpdateYtDlpCommand}" />
                                </Grid>
                            </Border>

                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="body-strong" Text="ffmpeg" />
                                    <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                                               Text="{Binding FFmpegVersion, TargetNullValue={x:Static res:Strings.Tools_NotInstalled}}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="body-strong" Text="{Binding JsRuntimeName}" />
                                    <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                                               Text="{Binding JsRuntimeVersion, TargetNullValue={x:Static res:Strings.Tools_NotInstalled}}" />
                                </StackPanel>
                            </Border>

                            <!-- MusicBrainz: a web service, not a bundled tool -->
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body-strong" Text="MusicBrainz"
                                                   ToolTip.Tip="{x:Static res:Strings.Mb_About}" />
                                        <TextBlock Classes="setting-hint" Text="{x:Static res:Strings.Settings_MusicBrainzHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Content="{x:Static res:Strings.Settings_MusicBrainzAuto}"
                                              ToolTip.Tip="{x:Static res:Strings.Settings_MusicBrainzAutoHint}"
                                              IsChecked="{Binding MusicBrainzAuto}" />
                                </Grid>
                            </Border>

                            <!-- Last.fm: genres for tracks MusicBrainz has none for, with the user's own key -->
                            <Border Classes="row">
                                <StackPanel Spacing="{StaticResource Space.2}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="body-strong" Text="Last.fm" />
                                            <TextBlock Classes="setting-hint" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_LastFmHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="link"
                                                VerticalAlignment="Center"
                                                Content="{x:Static res:Strings.Settings_LastFmGetKey}"
                                                ToolTip.Tip="{x:Static res:Strings.Settings_LastFmGetKeyHint}"
                                                Command="{Binding OpenLastFmKeyPageCommand}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.2}">
                                        <TextBox Text="{Binding LastFmApiKey}"
                                                 PlaceholderText="{x:Static res:Strings.Settings_LastFmKeyPlaceholder}"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="{x:Static res:Strings.Settings_LastFmKeyPlaceholder}" />
                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Content="{Binding LastFmFetchLabel}"
                                                ToolTip.Tip="{x:Static res:Strings.Settings_LastFmFetchHint}"
                                                Command="{Binding FetchLastFmCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- LRCLIB: lyrics for the downloaded tracks, a web service without a key -->
                            <Border Classes="row">
                                <StackPanel Spacing="{StaticResource Space.2}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="body-strong" Text="LRCLIB" />
                                            <TextBlock Classes="setting-hint" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_LyricsHint}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Content="{x:Static res:Strings.Settings_LyricsAuto}"
                                                  ToolTip.Tip="{x:Static res:Strings.Settings_LyricsAutoHint}"
                                                  IsChecked="{Binding LyricsAuto}" />
                                    </Grid>
                                    <Button Classes="secondary"
                                            HorizontalAlignment="Right"
                                            Content="{Binding LyricsFetchLabel}"
                                            ToolTip.Tip="{x:Static res:Strings.Settings_LyricsFetchHint}"
                                            Command="{Binding FetchLyricsCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </controls:Island>
                </controls:AdaptiveColumns>

                <!-- Credits: the open source projects Tapedeck builds on -->
                <controls:Island Classes="large">
                    <StackPanel Spacing="{StaticResource Space.4}">
                        <StackPanel Classes="heading">
                            <TextBlock Classes="title" Text="{x:Static res:Strings.Settings_Credits}" />
                            <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.Settings_CreditsHint}" />
                        </StackPanel>
                        <ContentControl Content="{Binding OwnCredit}" ContentTemplate="{StaticResource CreditCard}" />
                        <ItemsControl ItemsSource="{Binding Credits}" ItemTemplate="{StaticResource CreditCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Classes="credits" ColumnSpacing="{StaticResource Space.2}" RowSpacing="{StaticResource Space.2}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Classes="heading">
                            <TextBlock Classes="body-strong" Text="{x:Static res:Strings.Settings_CreditsAlso}" />
                            <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.Settings_CreditsAlsoHint}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding AlsoIncluded}" ItemTemplate="{StaticResource CreditCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Classes="credits" ColumnSpacing="{StaticResource Space.2}" RowSpacing="{StaticResource Space.2}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </controls:Island>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
