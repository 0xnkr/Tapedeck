<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Tapedeck.Resources"
             xmlns:vm="using:Tapedeck.ViewModels"
             xmlns:controls="using:Tapedeck.Controls"
             xmlns:converters="using:Tapedeck.Converters"
             xmlns:views="using:Tapedeck.Views"
             xmlns:library="using:Tapedeck.Views.Library"
             x:Class="Tapedeck.Views.PlaylistDetailView"
             x:DataType="vm:PlaylistDetailViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource Space.3}">

        <controls:PageHeader Title="{Binding Name}"
                             Subtitle="{Binding Summary}"
                             BackCommand="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.2}">
                <Button Classes="lg danger"
                        Content="{x:Static res:Strings.Playlist_Delete}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Trash}"
                        Command="{Binding DeleteCommand}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Library_ExportCsv}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Upload}"
                        Command="{Binding ExportCsvCommand}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlist_Rename}"
                        Command="{Binding RenameCommand}"
                        IsVisible="{Binding IsEditable}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlist_EditRules}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                        ToolTip.Tip="{x:Static res:Strings.Playlist_EditRulesHint}"
                        Command="{Binding EditRulesCommand}"
                        IsVisible="{Binding IsSmart}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlist_Sync}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                        ToolTip.Tip="{x:Static res:Strings.Playlist_SyncHint}"
                        Command="{Binding SyncCommand}"
                        IsVisible="{Binding IsLinked}" />
                <Button Classes="primary lg"
                        Content="{x:Static res:Strings.Playlist_Download}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Download}"
                        Command="{Binding DownloadCommand}" />
            </StackPanel>
        </controls:PageHeader>

        <TextBlock Grid.Row="1"
                   Classes="support"
                   Text="{Binding Notice}"
                   Foreground="{DynamicResource Brush.Error}"
                   Margin="22,0"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <controls:Island Grid.Row="2" Classes="table">
            <DockPanel>
                <views:PlaylistColumnsGrid DockPanel.Dock="Top" Height="36" Margin="12,4,12,0">
                    <views:PlaylistColumnsGrid.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                            <Setter Property="LetterSpacing" Value="0.3" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </views:PlaylistColumnsGrid.Styles>
                    <TextBlock Grid.Column="1" Classes="label medium" Text="#" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Classes="label medium" Text="{x:Static res:Strings.Column_Title}" />
                    <TextBlock Grid.Column="4" Classes="label medium" Text="{x:Static res:Strings.Column_Duration}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Classes="label medium" Text="{x:Static res:Strings.Column_Status}" />
                </views:PlaylistColumnsGrid>

                <Panel>
                    <ListBox Name="EntryList"
                             Theme="{StaticResource PlainList}"
                             ItemContainerTheme="{StaticResource TableRow}"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             DragDrop.AllowDrop="True"
                             AutomationProperties.Name="{Binding Name}">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
                            <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
                            <KeyBinding Gesture="Enter" Command="{Binding SelectedEntry.Row.OpenDetailsCommand, FallbackValue={x:Null}}" />
                        </ListBox.KeyBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistEntryViewModel">
                                <views:PlaylistColumnsGrid VerticalAlignment="Center">
                                    <Border Classes="drag-handle"
                                            IsVisible="{Binding $parent[ListBox].((vm:PlaylistDetailViewModel)DataContext).IsEditable, FallbackValue=True}"
                                            Background="Transparent"
                                            Cursor="SizeNorthSouth"
                                            ToolTip.Tip="{x:Static res:Strings.Playlist_DragHandle}"
                                            AutomationProperties.Name="{x:Static res:Strings.Playlist_DragHandle}">
                                        <controls:Glyph Data="{StaticResource Icon.Grip}"
                                                        IsFilled="True" StrokeThickness="0"
                                                        Width="18" Height="18"
                                                        Foreground="{DynamicResource Brush.Text3}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Classes="support tabular"
                                               Text="{Binding Number}"
                                               Foreground="{DynamicResource Brush.Text3}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <library:CoverButton Grid.Column="2" Width="72" Height="40" DataContext="{Binding Row}" />
                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                        <Button Classes="link" Command="{Binding Row.OpenDetailsCommand}">
                                            <TextBlock Classes="body-strong" Text="{Binding Row.Title}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <TextBlock Classes="support"
                                                   Text="{Binding Row.Artist}"
                                                   Foreground="{DynamicResource Brush.Text2}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4"
                                               Classes="support tabular"
                                               Text="{Binding Row.DurationText}"
                                               Foreground="{DynamicResource Brush.Text2}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <controls:StatusChip Grid.Column="5"
                                                         Status="{Binding Row.Status}"
                                                         Progress="{Binding Row.Progress}"
                                                         VerticalAlignment="Center" />
                                    <Button Grid.Column="6"
                                            Classes="icon"
                                            controls:ButtonAssist.Icon="{StaticResource Icon.Close}"
                                            Command="{Binding $parent[ListBox].((vm:PlaylistDetailViewModel)DataContext).RemoveTrackCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding $parent[ListBox].((vm:PlaylistDetailViewModel)DataContext).IsEditable, FallbackValue=True}"
                                            AutomationProperties.Name="{x:Static res:Strings.Playlist_RemoveTrack}"
                                            ToolTip.Tip="{x:Static res:Strings.Playlist_RemoveTrack}"
                                            VerticalAlignment="Center" />
                                </views:PlaylistColumnsGrid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="body"
                               Text="{Binding EmptyText}"
                               Foreground="{DynamicResource Brush.Text2}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsEmpty}" />
                </Panel>
            </DockPanel>
        </controls:Island>
    </Grid>
</UserControl>
