<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Only on a phone (App loads it on Android): what fingers need and a mouse does not. -->

    <!-- Menu entries as high as a touch target; the desktop's are sized for the mouse -->
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="{StaticResource Control.Xl}" />
    </Style>
</Styles>
