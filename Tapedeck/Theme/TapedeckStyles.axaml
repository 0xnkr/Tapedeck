<!-- Style root of the Tapedeck theme: typography and styles on top of Fluent's templates. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StyleInclude Source="avares://Tapedeck/Theme/Tokens/Typography.axaml" />
    <StyleInclude Source="avares://Tapedeck/Theme/Controls/Inputs.axaml" />
    <StyleInclude Source="avares://Tapedeck/Theme/Controls/RatingStyles.axaml" />

    <!-- Code line on an island: file names, paths -->
    <Style Selector="Border.code">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Frame of a segmented button (RadioButtons with Theme="{StaticResource Segment}") -->
    <Style Selector="Border.segmented">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Height" Value="{StaticResource Control.Md}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- A row on an island, e.g. one tool in the settings -->
    <Style Selector="Border.row">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
        <Setter Property="Padding" Value="16,12,12,12" />
    </Style>

    <!-- Small neutral pill for a short fact, e.g. a license in the credits -->
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Pending}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
    </Style>
</Styles>
