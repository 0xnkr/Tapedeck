<?xml version="1.0" encoding="utf-8"?>
<!-- Single Tapedeck.exe for Windows: the .NET runtime and native libraries are bundled, nothing to install.
     dotnet publish Tapedeck -p:PublishProfile=win-x64
     yt-dlp, ffmpeg and Deno are not bundled; the app downloads them on first use. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SkiaSharp, HarfBuzz and SQLite go into the .exe and are extracted to a temp folder on first start -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Dapper and the DI container use reflection, so trimming would break at runtime -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>..\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- DebugType only covers this project: drop the symbols of Core, Data and the SkiaSharp and HarfBuzz packages too -->
  <Target Name="LeaveOutSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
