<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Tapedeck.Resources"
             xmlns:vm="using:Tapedeck.ViewModels"
             xmlns:controls="using:Tapedeck.Controls"
             x:Class="Tapedeck.Views.PlaylistsView"
             x:DataType="vm:PlaylistsViewModel">

    <UserControl.Styles>
        <!-- The header's actions as buttons when there is room, else in a menu; the playlists in one column -->
        <Style Selector="Button#MoreActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UniformGrid.playlist-grid">
            <Setter Property="Columns" Value="3" />
        </Style>
        <ContainerQuery Name="page" Query="max-width:720">
            <Style Selector="StackPanel#Actions">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Button#MoreActions">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="UniformGrid.playlist-grid">
                <Setter Property="Columns" Value="1" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource Space.3}"
          Container.Name="page" Container.Sizing="Width">

        <controls:PageHeader Title="{x:Static res:Strings.Playlists_Title}"
                             Subtitle="{x:Static res:Strings.Playlists_Hint}">
            <Panel>
            <StackPanel Name="Actions" Orientation="Horizontal" Spacing="{StaticResource Space.2}">
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlists_FromSpotify}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Star}"
                        ToolTip.Tip="{x:Static res:Strings.Playlists_FromSpotifyHint}"
                        IsVisible="{Binding CanImportFromSpotify}"
                        Command="{Binding ImportFromSpotifyCommand}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlists_FromCsv}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Download}"
                        ToolTip.Tip="{x:Static res:Strings.Playlists_FromCsvHint}"
                        Command="{Binding ImportFromCsvCommand}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlists_FromLink}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Link}"
                        ToolTip.Tip="{x:Static res:Strings.Playlists_FromLinkHint}"
                        Command="{Binding ImportFromLinkCommand}" />
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Playlists_NewSmart}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                        ToolTip.Tip="{x:Static res:Strings.Playlists_NewSmartHint}"
                        Command="{Binding CreateSmartCommand}" />
                <Button Classes="primary lg"
                        Content="{x:Static res:Strings.Playlists_New}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Plus}"
                        Command="{Binding CreateCommand}" />
            </StackPanel>

            <!-- Narrow (a phone): the same actions in a menu -->
            <Button Name="MoreActions"
                    Classes="icon"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static res:Strings.Track_MoreActions}">
                <controls:Glyph Data="{StaticResource Icon.More}" IsFilled="True" StrokeThickness="0" Width="20" Height="20" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{x:Static res:Strings.Playlists_New}" Command="{Binding CreateCommand}" />
                        <MenuItem Header="{x:Static res:Strings.Playlists_NewSmart}" Command="{Binding CreateSmartCommand}" />
                        <MenuItem Header="{x:Static res:Strings.Playlists_FromLink}" Command="{Binding ImportFromLinkCommand}" />
                        <MenuItem Header="{x:Static res:Strings.Playlists_FromCsv}" Command="{Binding ImportFromCsvCommand}" />
                        <MenuItem Header="{x:Static res:Strings.Playlists_FromSpotify}" Command="{Binding ImportFromSpotifyCommand}"
                                  IsVisible="{Binding CanImportFromSpotify}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            </Panel>
        </controls:PageHeader>

        <TextBlock Grid.Row="1"
                   Classes="support"
                   Text="{Binding Notice}"
                   Foreground="{DynamicResource Brush.Error}"
                   Margin="22,0"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <controls:Island Grid.Row="2" Classes="table">
            <Panel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Playlists}" Margin="4" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Classes="playlist-grid" ColumnSpacing="{StaticResource Space.2}" RowSpacing="{StaticResource Space.2}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                                <Button Classes="link"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding OpenCommand}"
                                        AutomationProperties.Name="{Binding OpenLabel}">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.3}">
                                            <!-- smart playlists fill themselves, hence the refresh arrows -->
                                            <Panel VerticalAlignment="Center">
                                                <controls:Glyph Data="{StaticResource Icon.Playlists}"
                                                                Width="24" Height="24"
                                                                Foreground="{DynamicResource Brush.Text2}"
                                                                IsVisible="{Binding !IsSmart}" />
                                                <controls:Glyph Data="{StaticResource Icon.Refresh}"
                                                                Width="24" Height="24"
                                                                Foreground="{DynamicResource Brush.Accent}"
                                                                IsVisible="{Binding IsSmart}" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="support" Text="{Binding Summary}" Foreground="{DynamicResource Brush.Text2}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Classes="body"
                           Text="{x:Static res:Strings.Playlists_Empty}"
                           Foreground="{DynamicResource Brush.Text2}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="420"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsEmpty}" />
            </Panel>
        </controls:Island>
    </Grid>
</UserControl>
