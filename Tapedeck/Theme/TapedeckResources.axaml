<!--
    Resource root of the Tapedeck theme: tokens, icons and ControlThemes.
    Merged into Application.Resources so AccentService can override entries at runtime.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Tapedeck/Theme/Tokens/Palette.axaml" />
        <ResourceInclude Source="avares://Tapedeck/Theme/Tokens/Brushes.axaml" />
        <ResourceInclude Source="avares://Tapedeck/Theme/Tokens/Layout.axaml" />
        <ResourceInclude Source="avares://Tapedeck/Theme/Icons.axaml" />
        <ResourceInclude Source="avares://Tapedeck/Theme/Controls/Buttons.axaml" />
        <ResourceInclude Source="avares://Tapedeck/Theme/Controls/Components.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
