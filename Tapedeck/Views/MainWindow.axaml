<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tapedeck.ViewModels"
        xmlns:controls="using:Tapedeck.Controls"
        xmlns:views="using:Tapedeck.Views"
        x:Class="Tapedeck.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tapedeck.ico"
        Title="Tapedeck"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </Window.KeyBindings>

    <!-- Custom title bar above the shell (MainView) -->
    <Grid RowDefinitions="Auto,*">
        <controls:TitleBar />

        <views:MainView Grid.Row="1" />
    </Grid>
</Window>
