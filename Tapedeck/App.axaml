<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tapedeck.App"
             xmlns:local="using:Tapedeck"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Top level stays empty in XAML: AccentService writes its derived colors here at runtime. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tapedeck/Theme/TapedeckResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Tapedeck/Theme/TapedeckStyles.axaml" />
        <StyleInclude Source="avares://Tapedeck/Views/PlaylistMenuStyles.axaml" />
        <StyleInclude Source="avares://Tapedeck/Views/ChoiceMenuStyles.axaml" />
    </Application.Styles>
</Application>
