<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Tapedeck.Resources"
        xmlns:vm="using:Tapedeck.ViewModels"
        xmlns:controls="using:Tapedeck.Controls"
        xmlns:converters="using:Tapedeck.Converters"
        x:Class="Tapedeck.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tapedeck.ico"
        Title="Tapedeck"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </Window.KeyBindings>

    <!-- Shell: custom title bar, navigation rail, current page -->
    <Grid RowDefinitions="Auto,*">
        <controls:TitleBar />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <DockPanel Width="{StaticResource Size.Rail}" Margin="0,12,0,20">
                <RadioButton DockPanel.Dock="Bottom"
                             Theme="{StaticResource NavigationRailItem}"
                             GroupName="Navigation"
                             HorizontalAlignment="Center"
                             Content="{x:Static res:Strings.Nav_Settings}"
                             controls:ButtonAssist.Icon="{StaticResource Icon.Settings}"
                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={x:Static converters:EqualsConverter.INSTANCE}, ConverterParameter={x:Static vm:AppPage.Settings}}"
                             Command="{Binding ShowPageCommand}"
                             CommandParameter="{x:Static vm:AppPage.Settings}" />
                <StackPanel Spacing="{StaticResource Space.4}" HorizontalAlignment="Center">
                    <RadioButton Theme="{StaticResource NavigationRailItem}"
                                 GroupName="Navigation"
                                 Content="{x:Static res:Strings.Nav_Library}"
                                 controls:ButtonAssist.Icon="{StaticResource Icon.Library}"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={x:Static converters:EqualsConverter.INSTANCE}, ConverterParameter={x:Static vm:AppPage.Library}}"
                             Command="{Binding ShowPageCommand}"
                             CommandParameter="{x:Static vm:AppPage.Library}" />
                    <RadioButton Theme="{StaticResource NavigationRailItem}"
                                 GroupName="Navigation"
                                 Content="{x:Static res:Strings.Nav_Playlists}"
                                 controls:ButtonAssist.Icon="{StaticResource Icon.Playlists}"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={x:Static converters:EqualsConverter.INSTANCE}, ConverterParameter={x:Static vm:AppPage.Playlists}}"
                                 Command="{Binding ShowPageCommand}"
                                 CommandParameter="{x:Static vm:AppPage.Playlists}" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,4,16,16">

            <!-- Player bar below the page, so it never covers a table or the toast -->
            <controls:Island DockPanel.Dock="Bottom"
                             Margin="0,12,0,0"
                             Padding="10"
                             IsVisible="{Binding Player.HasTrack}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space.3}">
                    <Button Classes="link"
                            Command="{Binding OpenPlayingCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Player_OpenDetails}"
                            AutomationProperties.Name="{x:Static res:Strings.Player_OpenDetails}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.3}">
                            <Border Width="40" Height="40"
                                    CornerRadius="{StaticResource Radius.Thumb}"
                                    Background="{DynamicResource Brush.Surface3}"
                                    ClipToBounds="True">
                                <Image controls:ImageLoader.DecodeWidth="80" controls:ImageLoader.Path="{Binding Player.Cover}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="260">
                                <TextBlock Classes="body-strong" Text="{Binding Player.Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="support" Text="{Binding Player.Artist}" Foreground="{DynamicResource Brush.Text2}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Panel Grid.Column="1" VerticalAlignment="Center">
                        <Button Classes="icon"
                                Command="{Binding Player.TogglePauseCommand}"
                                ToolTip.Tip="{x:Static res:Strings.Player_Pause}"
                                AutomationProperties.Name="{x:Static res:Strings.Player_Pause}"
                                IsVisible="{Binding Player.IsPlaying}">
                            <controls:Glyph Data="{StaticResource Icon.Pause}" IsFilled="True" StrokeThickness="0" Width="20" Height="20" />
                        </Button>
                        <Button Classes="icon"
                                Command="{Binding Player.TogglePauseCommand}"
                                ToolTip.Tip="{x:Static res:Strings.Player_Play}"
                                AutomationProperties.Name="{x:Static res:Strings.Player_Play}"
                                IsVisible="{Binding !Player.IsPlaying}">
                            <controls:Glyph Data="{StaticResource Icon.Play}" IsFilled="True" StrokeThickness="0" Width="20" Height="20" />
                        </Button>
                    </Panel>

                    <TextBlock Grid.Column="2" Classes="support tabular" Text="{Binding Player.PositionText}"
                               Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" />
                    <Slider Grid.Column="3"
                            Minimum="0"
                            Maximum="{Binding Player.DurationSeconds}"
                            Value="{Binding Player.PositionSeconds}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.Player_Seek}"
                            AutomationProperties.Name="{x:Static res:Strings.Player_Seek}" />
                    <TextBlock Grid.Column="4" Classes="support tabular" Text="{Binding Player.DurationText}"
                               Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" />
                    <Button Grid.Column="5"
                            Classes="icon"
                            VerticalAlignment="Center"
                            controls:ButtonAssist.Icon="{StaticResource Icon.Close}"
                            Command="{Binding Player.StopCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Player_Close}"
                            AutomationProperties.Name="{x:Static res:Strings.Player_Close}" />
                </Grid>
            </controls:Island>

            <Panel>
                <ContentControl Content="{Binding Navigation.Current}" />

                <!-- Activity toast: spinning record while busy, resting record for the confirmation -->
                <controls:Island Classes="toast"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,16,16"
                                 IsVisible="{Binding Activity.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.3}">
                        <controls:VinylSpinner IsSpinning="{Binding Activity.IsBusy}" />
                        <TextBlock Classes="support"
                                   Text="{Binding Activity.Text}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   MaxWidth="360"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </controls:Island>
            </Panel>
            </DockPanel>
        </Grid>

        <!-- Confirmation dialog over everything below the title bar -->
        <ContentControl Grid.Row="1"
                        Content="{Binding Dialogs.Current}"
                        IsVisible="{Binding Dialogs.Current, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Grid>
</Window>
