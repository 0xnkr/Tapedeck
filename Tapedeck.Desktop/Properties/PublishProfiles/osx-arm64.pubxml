<?xml version="1.0" encoding="utf-8"?>
<!-- Tapedeck for macOS (arm64): the .NET runtime and native libraries are bundled, nothing to install.
     dotnet publish Tapedeck.Desktop -p:PublishProfile=osx-arm64
     Not a single file: the output becomes Tapedeck.app/Contents/MacOS (tools/macos-bundle.sh), where native libraries
     are loaded from next to the executable. yt-dlp, ffmpeg and Deno are not bundled; the app downloads them on first use. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Dapper and the DI container use reflection, so trimming would break at runtime -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>../publish/osx-arm64/</PublishDir>
  </PropertyGroup>

  <!-- DebugType only covers this project: drop the symbols of Core, Data and the SkiaSharp and HarfBuzz packages too -->
  <Target Name="LeaveOutSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
