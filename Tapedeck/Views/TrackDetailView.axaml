<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Tapedeck.Resources"
             xmlns:vm="using:Tapedeck.ViewModels"
             xmlns:controls="using:Tapedeck.Controls"
             xmlns:detail="using:Tapedeck.Views.Detail"
             x:Class="Tapedeck.Views.TrackDetailView"
             x:DataType="vm:TrackDetailViewModel">

    <UserControl.Styles>
        <!-- The header's actions as buttons when there is room, else in a menu -->
        <Style Selector="Button#MoreActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UniformGrid#Facts">
            <Setter Property="Columns" Value="4" />
        </Style>
        <ContainerQuery Name="page" Query="max-width:720">
            <Style Selector="StackPanel#Actions">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Button#MoreActions">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="UniformGrid#Facts">
                <Setter Property="Columns" Value="2" />
            </Style>
        </ContainerQuery>

        <!-- Labels and values of the small fact grids (file, YouTube) -->
        <Style Selector="TextBlock.fact-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
        </Style>

        <!-- Lines of the lyrics panel: as wide as the island, the text left aligned and wrapping -->
        <Style Selector="Button.lyric-line">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource Space.3}"
          Container.Name="page" Container.Sizing="Width">

        <controls:PageHeader Title="{Binding Title}"
                             Subtitle="{Binding Subtitle}"
                             BackCommand="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.2}">
                <!-- Previous and next track of the list the page was opened from (also arrow keys) -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}" VerticalAlignment="Center"
                            IsVisible="{Binding PositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Button Classes="icon"
                            controls:ButtonAssist.Icon="{StaticResource Icon.ChevronLeft}"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Detail_PreviousHint}"
                            AutomationProperties.Name="{x:Static res:Strings.Detail_Previous}" />
                    <TextBlock Classes="support tabular"
                               Text="{Binding PositionText}"
                               Foreground="{DynamicResource Brush.Text2}"
                               VerticalAlignment="Center" />
                    <Button Classes="icon"
                            controls:ButtonAssist.Icon="{StaticResource Icon.ChevronRight}"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Detail_NextHint}"
                            AutomationProperties.Name="{x:Static res:Strings.Detail_Next}" />
                </StackPanel>
                <StackPanel Name="Actions" Orientation="Horizontal" Spacing="{StaticResource Space.2}">
                <Button Classes="lg"
                        Content="{x:Static res:Strings.Track_OpenOnYoutube}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.ExternalLink}"
                        Command="{Binding OpenOnYoutubeCommand}" />
                <Button Classes="lg"
                        Content="{x:Static res:Strings.Track_AddToPlaylist}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Playlists}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight"
                                    FlyoutPresenterClasses="playlist-menu"
                                    ItemsSource="{Binding Row.PlaylistMenu}"
                                    Opening="OnPlaylistMenuOpening" />
                    </Button.Flyout>
                </Button>
                <Button Classes="secondary lg"
                        Content="{x:Static res:Strings.Detail_Redownload}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                        Command="{Binding RedownloadCommand}" />
                <Button Classes="primary lg"
                        Content="{x:Static res:Strings.Detail_WriteTags}"
                        controls:ButtonAssist.Icon="{StaticResource Icon.Tag}"
                        Command="{Binding WriteTagsCommand}" />
                </StackPanel>

                <!-- Narrow (a phone): the same actions in a menu -->
                <Button Name="MoreActions"
                        Classes="icon"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:Strings.Track_MoreActions}">
                    <controls:Glyph Data="{StaticResource Icon.More}" IsFilled="True" StrokeThickness="0" Width="20" Height="20" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnPlaylistMenuOpening">
                            <MenuItem Header="{x:Static res:Strings.Detail_WriteTags}" Command="{Binding WriteTagsCommand}" />
                            <MenuItem Header="{x:Static res:Strings.Detail_Redownload}" Command="{Binding RedownloadCommand}" />
                            <MenuItem Header="{x:Static res:Strings.Track_AddToPlaylist}"
                                      Classes="playlist-menu"
                                      ItemsSource="{Binding Row.PlaylistMenu}" />
                            <MenuItem Header="{x:Static res:Strings.Track_OpenOnYoutube}" Command="{Binding OpenOnYoutubeCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!-- Hints below the header: outdated tags, last error -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource Space.1}" Margin="56,0,0,0">
            <TextBlock Classes="support"
                       Text="{x:Static res:Strings.Detail_TagsStale}"
                       Foreground="{DynamicResource Brush.Accent}"
                       IsVisible="{Binding TagsStale}" />
            <TextBlock Classes="support"
                       Text="{Binding Notice}"
                       Foreground="{DynamicResource Brush.Error}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- The islands scroll below the fixed header when the window is too low for them -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- Two columns, one below the other on a phone -->
        <controls:AdaptiveColumns FirstWidth="400" Spacing="{StaticResource Space.3}" Margin="0,0,0,4">

            <!-- Left: preview and file -->
            <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.3}">
                <controls:Island Padding="12" AutomationProperties.Name="{x:Static res:Strings.Detail_Preview}">
                    <StackPanel Spacing="{StaticResource Space.3}">
                        <!-- Plays the downloaded file, like the covers in the tables; YouTube is in the header -->
                        <Button Classes="link"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding Row.TogglePlayCommand}"
                                ToolTip.Tip="{Binding Row.PlayTooltip}"
                                AutomationProperties.Name="{Binding Row.PlayTooltip}">
                            <Border Height="211"
                                    CornerRadius="{StaticResource Radius.Field}"
                                    Background="{DynamicResource Brush.Surface3}"
                                    ClipToBounds="True">
                                <Panel>
                                    <Image controls:ImageLoader.DecodeWidth="752" controls:ImageLoader.Path="{Binding ThumbPath}"
                                           Stretch="UniformToFill" />
                                    <Border Width="56" Height="56"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Background="{DynamicResource Brush.Bg}"
                                            Opacity="0.6" />
                                    <controls:Glyph Data="{StaticResource Icon.Play}"
                                                    IsFilled="True" StrokeThickness="0"
                                                    Width="24" Height="24"
                                                    Foreground="{DynamicResource Brush.Text}"
                                                    IsVisible="{Binding !Row.IsPlaying}" />
                                    <controls:Glyph Data="{StaticResource Icon.Pause}"
                                                    IsFilled="True" StrokeThickness="0"
                                                    Width="24" Height="24"
                                                    Foreground="{DynamicResource Brush.Accent}"
                                                    IsVisible="{Binding Row.IsPlaying}" />
                                </Panel>
                            </Border>
                        </Button>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.3}" Margin="4,0,4,4">
                            <Border Width="56" Height="56"
                                    CornerRadius="{StaticResource Radius.Field}"
                                    Background="{DynamicResource Brush.Surface3}"
                                    ClipToBounds="True">
                                <Image controls:ImageLoader.DecodeWidth="224" controls:ImageLoader.Path="{Binding CoverPath}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="support" FontWeight="SemiBold" Text="{x:Static res:Strings.Detail_Cover}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text2}" Text="{Binding CoverText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Choosing a cover comes with v2 -->
                            <Button Grid.Column="2" Classes="tonal" Content="{x:Static res:Strings.Detail_ChangeCover}" IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                </controls:Island>

                <controls:Island Grid.Row="1">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="title" Text="{x:Static res:Strings.Detail_File}" VerticalAlignment="Center" />
                            <controls:StatusChip Grid.Column="1" Status="{Binding Row.Status}" Progress="{Binding Row.Progress}" />
                        </Grid>
                        <Border Classes="code">
                            <Panel>
                                <TextBlock Classes="mono" Text="{Binding FileName}" Foreground="{DynamicResource Brush.TextSoft}"
                                           TextWrapping="Wrap" IsVisible="{Binding HasFile}" />
                                <TextBlock Classes="support" Text="{x:Static res:Strings.Detail_NoFile}" Foreground="{DynamicResource Brush.Text3}"
                                           IsVisible="{Binding !HasFile}" />
                            </Panel>
                        </Border>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="{StaticResource Space.3}">
                            <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" Text="{x:Static res:Strings.Detail_Format}" />
                            <TextBlock Grid.Column="1" Classes="support" Text="{Binding FileFormat}" />
                            <TextBlock Grid.Row="1" Classes="support" Foreground="{DynamicResource Brush.Text2}" Text="{x:Static res:Strings.Detail_DownloadedAt}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="support" Text="{Binding DownloadedAt}" />
                        </Grid>
                        <TextBlock Classes="support"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <!-- File actions; the cancel button only shows while downloading -->
                        <StackPanel>
                            <Button Classes="text"
                                    HorizontalAlignment="Left"
                                    Margin="-8,0,0,0"
                                    Content="{x:Static res:Strings.Track_ShowInFolder}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Folder}"
                                    Command="{Binding ShowInFolderCommand}" />
                            <Button Classes="danger"
                                    HorizontalAlignment="Left"
                                    Margin="-8,0,0,0"
                                    Content="{x:Static res:Strings.Track_CancelDownload}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Stop}"
                                    Command="{Binding Row.CancelDownloadCommand}"
                                    IsVisible="{Binding Row.IsDownloading}" />
                            <Button Classes="danger"
                                    HorizontalAlignment="Left"
                                    Margin="-8,0,0,0"
                                    Content="{x:Static res:Strings.Detail_Remove}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Trash}"
                                    Command="{Binding Row.RemoveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </controls:Island>
            </Grid>

            <!-- Right: metadata, MusicBrainz match, YouTube facts and lyrics -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{StaticResource Space.3}">
                <controls:Island>
                    <StackPanel Spacing="{StaticResource Space.2}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="title" Text="{x:Static res:Strings.Detail_Metadata}" />
                            <TextBlock Grid.Column="1" Classes="fact-label" Text="{x:Static res:Strings.Detail_MetadataHint}" VerticalAlignment="Bottom" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Space.2}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetadataFieldViewModel">
                                    <detail:MetadataField />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="112,*,96" ColumnSpacing="{StaticResource Space.3}" MinHeight="{StaticResource Control.Lg}">
                            <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" Text="{x:Static res:Strings.Field_Genres}" VerticalAlignment="Center" />
                            <detail:GenreEditor Grid.Column="1" VerticalAlignment="Center" />
                            <controls:SourceChip Grid.Column="2" Source="{Binding GenresSource}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="112,*,96" ColumnSpacing="{StaticResource Space.3}" MinHeight="{StaticResource Control.Lg}">
                            <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" Text="{x:Static res:Strings.Field_Rating}" VerticalAlignment="Center" />
                            <controls:RatingView Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Rating}" StarSize="22" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </controls:Island>

                <!-- MusicBrainz: the applied match, or the suggestions to confirm -->
                <controls:Island Grid.Row="2">
                    <StackPanel Spacing="{StaticResource Space.2}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="title" Text="{x:Static res:Strings.Detail_MusicBrainz}"
                                       ToolTip.Tip="{x:Static res:Strings.Mb_About}" />
                            <TextBlock Grid.Column="1" Classes="fact-label" Text="{Binding MbStateText}" VerticalAlignment="Bottom" />
                        </Grid>

                        <StackPanel Spacing="2" IsVisible="{Binding IsMbMatched}">
                            <TextBlock Classes="body-strong" Text="{Binding MbRelease}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" Text="{Binding MbRecording}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Classes="support"
                                   Foreground="{DynamicResource Brush.Text2}"
                                   TextWrapping="Wrap"
                                   Text="{Binding MbHint}"
                                   IsVisible="{Binding MbHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <ItemsControl ItemsSource="{Binding MbCandidates}" IsVisible="{Binding HasMbCandidates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Space.1}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MbCandidateViewModel">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.2}">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="body-strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="support" Foreground="{DynamicResource Brush.Text2}" Text="{Binding Details}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="tonal"
                                                    VerticalAlignment="Center"
                                                    Content="{x:Static res:Strings.Mb_Apply}"
                                                    ToolTip.Tip="{x:Static res:Strings.Mb_ApplyHint}"
                                                    Command="{Binding ApplyCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}" Margin="-8,0,0,0">
                            <Button Classes="text"
                                    Content="{Binding MbSearchText}"
                                    ToolTip.Tip="{x:Static res:Strings.Mb_SearchHint}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Search}"
                                    Command="{Binding SearchMusicBrainzCommand}" />
                            <Button Classes="text"
                                    Content="{x:Static res:Strings.Mb_Open}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.ExternalLink}"
                                    Command="{Binding OpenMusicBrainzCommand}"
                                    IsVisible="{Binding IsMbMatched}" />
                            <Button Classes="danger"
                                    Content="{x:Static res:Strings.Mb_Unlink}"
                                    ToolTip.Tip="{x:Static res:Strings.Mb_UnlinkHint}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Close}"
                                    Command="{Binding RejectMusicBrainzCommand}"
                                    IsVisible="{Binding IsMbMatched}" />
                            <Button Classes="text"
                                    Content="{x:Static res:Strings.Mb_NoneOfThese}"
                                    ToolTip.Tip="{x:Static res:Strings.Mb_NoneOfTheseHint}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Close}"
                                    Command="{Binding RejectMusicBrainzCommand}"
                                    IsVisible="{Binding IsMbSuggested}" />
                        </StackPanel>
                    </StackPanel>
                </controls:Island>

                <controls:Island Grid.Row="3">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Classes="title" Text="{x:Static res:Strings.Detail_YouTube}" Margin="0,0,0,14" />
                        <!-- Four facts side by side, two by two when narrow -->
                        <UniformGrid Name="Facts" ColumnSpacing="16" RowSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fact-label" Text="{x:Static res:Strings.Detail_Channel}" />
                                <TextBlock Classes="body" Text="{Binding Channel}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fact-label" Text="{x:Static res:Strings.Detail_Uploaded}" />
                                <TextBlock Classes="body" Text="{Binding UploadedAt}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fact-label" Text="{x:Static res:Strings.Detail_VideoId}" />
                                <TextBlock Classes="mono" Text="{Binding VideoId}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fact-label" Text="{x:Static res:Strings.Detail_Added}" />
                                <TextBlock Classes="body" Text="{Binding AddedAt}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </controls:Island>

                <!--
                    Lyrics: timed ones follow the player (the line sung now big, the next one below), plain ones show as
                    text; the text box for pasting or correcting opens with "Edit". "Write tags" puts them into the
                    file and a .lrc next to it.
                -->
                <controls:Island Grid.Row="1">
                    <StackPanel Spacing="{StaticResource Space.2}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="title" Text="{x:Static res:Strings.Detail_Lyrics}"
                                       ToolTip.Tip="{x:Static res:Strings.Detail_LyricsAbout}" />
                            <TextBlock Grid.Column="1" Classes="fact-label" Text="{Binding LyricsState}" VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- clicking a line jumps there, and starts the track first when it is not playing -->
                        <StackPanel Spacing="2" IsVisible="{Binding ShowsLyricsPanel}" Margin="-8,0">
                            <Button Classes="text lyric-line"
                                    Command="{Binding LyricsPanel.SeekCommand}"
                                    CommandParameter="{Binding LyricsPanel.Current}"
                                    ToolTip.Tip="{x:Static res:Strings.Detail_LyricsJumpHint}">
                                <TransitioningContentControl Content="{Binding LyricsPanel.Current}">
                                    <TransitioningContentControl.PageTransition>
                                        <CrossFade Duration="0:0:0.25" />
                                    </TransitioningContentControl.PageTransition>
                                    <TransitioningContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:LyricLineViewModel">
                                            <TextBlock Classes="headline" Text="{Binding Shown}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </TransitioningContentControl.ContentTemplate>
                                </TransitioningContentControl>
                            </Button>
                            <Button Classes="text lyric-line"
                                    Command="{Binding LyricsPanel.SeekCommand}"
                                    CommandParameter="{Binding LyricsPanel.Next}"
                                    IsVisible="{Binding LyricsPanel.Next, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="{x:Static res:Strings.Detail_LyricsJumpHint}">
                                <TransitioningContentControl Content="{Binding LyricsPanel.Next}">
                                    <TransitioningContentControl.PageTransition>
                                        <CrossFade Duration="0:0:0.25" />
                                    </TransitioningContentControl.PageTransition>
                                    <TransitioningContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:LyricLineViewModel">
                                            <TextBlock Classes="body" Foreground="{DynamicResource Brush.Text3}"
                                                       Text="{Binding Shown}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </TransitioningContentControl.ContentTemplate>
                                </TransitioningContentControl>
                            </Button>
                            <TextBlock Classes="support"
                                       Foreground="{DynamicResource Brush.Text3}"
                                       Margin="8,4,8,0"
                                       Text="{x:Static res:Strings.Detail_LyricsPlayToFollow}"
                                       IsVisible="{Binding !LyricsPanel.IsFollowing}" />
                        </StackPanel>

                        <ScrollViewer MaxHeight="360" IsVisible="{Binding ShowsPlainLyrics}">
                            <SelectableTextBlock Classes="body" Text="{Binding LyricsText}" TextWrapping="Wrap" />
                        </ScrollViewer>

                        <TextBox Classes="user-value"
                                 Text="{Binding LyricsText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 MaxHeight="360"
                                 IsVisible="{Binding ShowsLyricsEditor}"
                                 PlaceholderText="{x:Static res:Strings.Detail_LyricsPlaceholder}"
                                 AutomationProperties.Name="{x:Static res:Strings.Detail_Lyrics}" />

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.1}" Margin="-8,0,0,0">
                            <Button Classes="text"
                                    Content="{Binding EditLyricsText}"
                                    ToolTip.Tip="{x:Static res:Strings.Detail_LyricsEditHint}"
                                    Command="{Binding EditLyricsCommand}"
                                    IsVisible="{Binding HasLyrics}" />
                            <Button Classes="text"
                                    Content="{x:Static res:Strings.Detail_LyricsSearch}"
                                    ToolTip.Tip="{x:Static res:Strings.Detail_LyricsSearchHint}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Search}"
                                    Command="{Binding SearchLyricsCommand}" />
                            <Button Classes="text"
                                    Content="{x:Static res:Strings.Detail_LyricsReset}"
                                    ToolTip.Tip="{x:Static res:Strings.Detail_LyricsResetHint}"
                                    controls:ButtonAssist.Icon="{StaticResource Icon.Close}"
                                    Command="{Binding ResetLyricsCommand}"
                                    IsVisible="{Binding HasUserLyrics}" />
                        </StackPanel>
                    </StackPanel>
                </controls:Island>
            </Grid>
        </controls:AdaptiveColumns>
        </ScrollViewer>
    </Grid>
</UserControl>
