<Project Sdk="Microsoft.NET.Sdk">
    <!-- Desktop head: starts the shared app in a window, adds the OpenAL player and the command line reports.
         Builds Tapedeck.exe (dotnet publish Tapedeck.Desktop -p:PublishProfile=win-x64). -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AssemblyName>Tapedeck</AssemblyName>
        <RootNamespace>Tapedeck</RootNamespace>
        <!-- Local builds; a release gets its version from the git tag (release.yml: -p:Version=1.2.3) -->
        <Version>0.0.0-dev</Version>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Icon of the .exe in Explorer and the taskbar; the window uses the same file (MainWindow.Icon) -->
        <ApplicationIcon>..\Tapedeck\Assets\tapedeck.ico</ApplicationIcon>
        <!-- OpenAL hands out device and context pointers (OpenAlPlayerService) -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
        <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tapedeck\Tapedeck.csproj" />
    </ItemGroup>
</Project>
