<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Tapedeck.Resources"
             xmlns:vm="using:Tapedeck.ViewModels"
             xmlns:controls="using:Tapedeck.Controls"
             x:Class="Tapedeck.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">

    <!-- Scrim over the window, the question on an island in the middle -->
    <Panel>
        <Border Background="{DynamicResource Brush.Bg}" Opacity="0.7" />
        <controls:Island Classes="large"
                         Width="440"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
            <StackPanel Spacing="{StaticResource Space.4}">
                <TextBlock Classes="title" Text="{Binding Request.Title}" TextWrapping="Wrap" />
                <TextBlock Classes="body" Text="{Binding Request.Message}" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap" />
                <CheckBox Content="{Binding Request.OptionText}"
                          IsChecked="{Binding Option}"
                          IsVisible="{Binding HasOption}" />
                <CheckBox Content="{x:Static res:Strings.Dialog_DontAskAgain}"
                          IsChecked="{Binding DontAskAgain}"
                          IsVisible="{Binding Request.OfferDontAsk}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.2}" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.Dialog_Cancel}"
                            Command="{Binding CancelCommand}" />
                    <Button Name="ConfirmButton"
                            Classes="tonal"
                            Classes.danger="{Binding Request.IsDestructive}"
                            Content="{Binding Request.ConfirmText}"
                            Command="{Binding ConfirmCommand}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:Island>
    </Panel>
</UserControl>
