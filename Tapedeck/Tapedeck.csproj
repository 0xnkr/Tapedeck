<Project Sdk="Microsoft.NET.Sdk">
    <!-- The app shared by all platforms: views, view models, theme, texts and services.
         The heads (Tapedeck.Desktop, later Tapedeck.Android) start it and add their platform services. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- Tapedeck.exe is the desktop head's assembly; namespaces and texts stay Tapedeck.* -->
        <AssemblyName>Tapedeck.Shared</AssemblyName>
        <RootNamespace>Tapedeck</RootNamespace>
        <!-- Local builds; a release gets its version from the git tag (release.yml: -p:Version=1.2.3) -->
        <Version>0.0.0-dev</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <!-- License texts shown in the settings, offline: the bundled libraries' licenses and Tapedeck's own LICENSE -->
    <ItemGroup>
        <EmbeddedResource Include="Licenses\*.txt" LogicalName="Tapedeck.Licenses.%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\LICENSE" LogicalName="Tapedeck.Licenses.tapedeck.txt" Link="Licenses\LICENSE" />
    </ItemGroup>

    <!-- UI texts: Strings.resx is English, Strings.<culture>.resx the translations.
         Rider and Visual Studio regenerate Strings.Designer.cs (class Tapedeck.Resources.Strings) when Strings.resx is saved. -->
    <ItemGroup>
        <EmbeddedResource Update="Resources\Strings.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <Compile Update="Resources\Strings.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Strings.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.5" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Tapedeck.Core\Tapedeck.Core.csproj" />
      <ProjectReference Include="..\Tapedeck.Data\Tapedeck.Data.csproj" />
    </ItemGroup>
</Project>
